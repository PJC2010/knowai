# Public website origin, required for deployed editor sign-in redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings. The publishable key is intended for public use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: never use a NEXT_PUBLIC_ prefix for these secrets.
SUPABASE_SECRET_KEY=
EDITORIAL_OPENROUTER_API_KEY=
CRON_SECRET=

# Comma-separated verified editor emails; also grant their user IDs in brief_editors.
EDITOR_EMAIL_ALLOWLIST=
EDITORIAL_MODEL=openai/gpt-4.1-mini
# Enable after the migration, sign-in setup, and first editorial approval.
BRIEF_V2_ENABLED=false
